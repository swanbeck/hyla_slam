<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hyla_examples</name>
  <version>1.0.0</version>
  <description>Example package for deploying hyla-slam in behavior trees</description>
  <maintainer email="steven.swanbeck@gmail.com">steven</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>behaviortree_cpp</build_depend>
  <build_depend>hyla_slam_behaviors</build_depend>
  <build_depend>watertender_behaviors</build_depend>

  <exec_depend>hyla_slam</exec_depend>
  <exec_depend>watertender</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
