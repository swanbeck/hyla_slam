<launch>

    <!-- Set to true when building a map with bagged data -->
    <arg name = "use_sim_time" default = "false"/>

    <!-- Behaviors node for servicing behavior requests -->
    <node pkg="hyla_slam" exec="hyla_slam_behaviors_node">
        <param from="$(find-pkg-share hyla_examples)/config/velodyne_params.yaml"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- Watertender is used to aggregate sensor data -->
    <node pkg="watertender" exec="watertender">
        <param from="$(find-pkg-share hyla_examples)/config/velodyne_params.yaml"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- Run the actual behavior tree using the slam config file -->
    <node pkg="hyla_examples" exec="run_behavior_tree">
        <param name="source_package" value="hyla_examples"/>
        <param name="behavior_tree_file" value="behavior_trees/slam.xml"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

</launch>